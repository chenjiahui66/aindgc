# Aindgc backend env (Phase 16 deployment)
# Copy to /etc/aindgc/backend.env and chmod 640; chown www-data:www-data

SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080

DB_USER=aindgc
DB_PASS=CHANGE_ME_STRONG_PASSWORD

# JWT
AINDGC_JWT_SECRET=CHANGE_ME_AT_LEAST_64_CHARS_RANDOM_BASE64

# Admin bootstrap (first boot only; ignored on subsequent boots)
AINDGC_ADMIN_USERNAME=admin
AINDGC_ADMIN_EMAIL=admin@aindgc.com
AINDGC_ADMIN_PASSWORD=CHANGE_ME_ON_FIRST_BOOT

# Uploads
AINDGC_UPLOAD_DIR=/opt/aindgc/uploads
