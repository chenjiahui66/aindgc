# Copy to .env and edit. .env is gitignored — never commit real secrets.
#
#   cp .env.example .env

# First-boot admin account. Created by InitDataInitializer only if absent,
# so changing it later has no effect — rotate the row in the database instead.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@aindgc.com
ADMIN_PASSWORD=CHANGE_ME_strong_password

# JWT signing key. Must be >= 32 chars — JwtUtil throws at startup if it is
# shorter. There is no placeholder-value check, so the dev default baked into
# application.yml WILL be accepted if you forget to set this. Generate a real
# one with:  openssl rand -base64 48
JWT_SECRET=CHANGE_ME_openssl_rand_base64_48
