# =====================================================================
# Aindgc · Production nginx config template
#
# Replace YOUR_DOMAIN below. Drop this file into /etc/nginx/sites-available/
# and symlink to /etc/nginx/sites-enabled/.
#
# Prereqs:
#   - certbot run for YOUR_DOMAIN to get Let's Encrypt certs
#   - Frontend built dist/ copied to /var/www/aindgc/
#   - Backend running as systemd service (see deploy/aindgc-backend.service)
#
# This is a TEMPLATE - variables must be substituted by deploy.sh.
# =====================================================================

# --- HTTP -> HTTPS redirect ---
server {
    listen      80;
    server_name YOUR_DOMAIN www.YOUR_DOMAIN admin.YOUR_DOMAIN api.YOUR_DOMAIN;
    return 301  https://$host$request_uri;
}

# --- Main site (aindgc.com + www.aindgc.com) ---
server {
    listen      443 ssl http2;
    server_name YOUR_DOMAIN www.YOUR_DOMAIN;

    ssl_certificate     /etc/letsencrypt/live/YOUR_DOMAIN/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/YOUR_DOMAIN/privkey.pem;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options    "nosniff" always;
    add_header X-Frame-Options           "SAMEORIGIN" always;
    add_header Referrer-Policy           "strict-origin-when-cross-origin" always;

    root /var/www/aindgc;
    index index.html;

    # SPA fallback - all non-API, non-asset paths serve index.html
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Static asset caching
    location ~* \.(?:js|css|woff2?|ttf|otf|svg|png|jpe?g|gif|webp|ico)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        access_log off;
    }

    # Backend API - same-origin (no CORS preflight needed)
    location /api/ {
        proxy_pass         http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    # Sitemap & robots
    location = /sitemap.xml {
        proxy_pass http://127.0.0.1:8080/sitemap.xml;
    }
    location = /robots.txt {
        proxy_pass http://127.0.0.1:8080/robots.txt;
    }

    # Gzip
    gzip on;
    gzip_min_length 1024;
    gzip_comp_level 5;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;

    access_log /var/log/nginx/aindgc.access.log;
    error_log  /var/log/nginx/aindgc.error.log;
}

# --- Admin (admin.aindgc.com) ---
server {
    listen      443 ssl http2;
    server_name admin.YOUR_DOMAIN;

    ssl_certificate     /etc/letsencrypt/live/YOUR_DOMAIN/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/YOUR_DOMAIN/privkey.pem;

    add_header X-Frame-Options "SAMEORIGIN" always;

    root /var/www/aindgc;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }

    location /api/ {
        proxy_pass         http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
    }

    access_log /var/log/nginx/aindgc-admin.access.log;
    error_log  /var/log/nginx/aindgc-admin.error.log;
}
