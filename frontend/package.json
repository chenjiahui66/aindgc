{
  "name": "aindgc-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Aindgc frontend - Vue 3 + TypeScript + Vite",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build:no-check": "vite build",
    "preview": "vite preview --port 4173",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint . --ext .vue,.ts,.tsx --fix",
    "lint:check": "eslint . --ext .vue,.ts,.tsx",
    "format": "prettier --write \"src/**/*.{vue,ts,tsx,js,css,scss,md,json}\" \"*.{ts,js,cjs,mjs,json,md}\""
  },
  "dependencies": {
    "vue": "^3.4.27",
    "vue-router": "^4.3.2",
    "pinia": "^2.1.7",
    "axios": "^1.7.2",
    "@vueuse/core": "^10.9.0",
    "element-plus": "^2.7.3",
    "@element-plus/icons-vue": "^2.3.1",
    "lucide-vue-next": "^0.378.0",
    "echarts": "^5.5.0",
    "vue-echarts": "^7.0.3",
    "@vue-flow/core": "^1.41.0",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.2",
    "@vue-flow/minimap": "^1.5.0",
    "dayjs": "^1.11.11",
    "markdown-it": "^14.1.0",
    "highlight.js": "^11.9.0",
    "shiki": "^1.3.0",
    "vue-i18n": "^9.13.1"
  },
  "devDependencies": {
    "@types/node": "^20.12.12",
    "@types/markdown-it": "^14.1.2",
    "@vitejs/plugin-vue": "^5.0.4",
    "@vue/tsconfig": "^0.5.1",
    "typescript": "~5.4.5",
    "vite": "^5.2.11",
    "vue-tsc": "^2.0.19",
    "unplugin-auto-import": "^0.17.6",
    "unplugin-vue-components": "^0.27.0",
    "eslint": "^8.57.0",
    "eslint-plugin-vue": "^9.24.0",
    "@typescript-eslint/eslint-plugin": "^7.10.0",
    "@typescript-eslint/parser": "^7.10.0",
    "prettier": "^3.2.5"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
